# Copy to .env on the lab VM if needed. Do not commit secrets.
LEVEL2_API_URL=http://level2-collector:8080
MATHMODEL_PORT=8090

# Multi-trigger recalc watch (optional; off by default)
# RECALC_POLL_ENABLED=1
# RECALC_WATCH_MODE=ws   # ws | poll | ws_with_poll_fallback
# POLL_INTERVAL_MS=1000  # poll interval / WS fallback tick
# RECALC_FLAG_TAG_ID=
# RECALC_TRIGGERS_PATH=/data/recalc-triggers.json
# LEVEL2_API_TOKEN=
